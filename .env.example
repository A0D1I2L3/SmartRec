# SerpApi key for live Google Shopping results (free plan: 250 searches/month)
# Get one at https://serpapi.com/ — optional: SmartRec falls back to its
# built-in laptop catalog when this key is missing or the monthly quota is spent.
PRODUCT_SEARCH_API_KEY=

# Port the Express API listens on (Vite dev proxies /api to this port).
PORT=3001

# Node environment: development | production
NODE_ENV=development
